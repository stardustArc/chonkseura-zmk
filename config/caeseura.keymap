#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        v_combo {
            bindings = <&kp V>;
            key-positions = <29 28>;
            layers = <0>;
        };

        j-combo {
            bindings = <&kp J>;
            key-positions = <4 3>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak-dh {
            bindings = <
&kp ESCAPE  &kp Q     &kp W  &kp F  &kp P  &kp B      &kp K     &kp L      &kp U  &kp Y      &kp SQT   &kp SEMI  &kp DEL
&kp TAB     &kp A     &kp R  &kp S  &kp T  &kp G      &kp M     &kp N      &kp E  &kp I      &kp O     &kp RET
&kp LSHFT   &kp Z     &kp X  &kp C  &kp D  &trans     &kp LGUI  &trans     &kp H  &kp COMMA  &kp DOT   &kp UP    &kp SLASH
&kp LCTRL   &kp RALT                &mo 1  &kp SPACE  &kp BSPC  &kp RSHFT                    &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            label = "colemak-dh";
        };

        num {
            bindings = <
&kp GRAVE  &kp N1  &kp N2      &kp N3      &kp N4      &kp N5   &kp N6  &kp N7                &kp N8                 &kp N9    &kp N0  &trans  &trans
&trans     &trans  &trans      &kp MINUS   &kp EQUAL   &trans   &trans  &kp LBKT              &kp RBKT               &kp BSLH  &trans  &trans
&trans     &to 2   &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &kp DEL  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans  &trans  &trans
&trans     &trans                          &trans      &trans   &trans  &trans                                                 &trans  &trans  &trans
            >;
        };

        game {
            bindings = <
&kp ESC    &kp Q   &kp W  &kp E  &kp R  &kp T      &kp GRAVE  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp A   &kp S  &kp D  &kp F  &kp G      &trans     &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp Z   &kp X  &kp C  &kp V  &kp B      &to 0      &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &trans                &mo 1  &kp SPACE  &trans     &trans                  &trans  &trans  &trans
            >;

            label = "game";
        };
    };
};
